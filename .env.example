# The Support Desk — copy to .env and fill in. Never commit .env.

# App
APP_ENV=development
ADMIN_TOKEN=
LOG_TEXT=0
EVAL_FAULTS=

# LLM (D2: groq | gemini | cues_only)
LLM_PROVIDER=cues_only
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Database (SQLite on the persistent volume in production)
DATABASE_URL=sqlite:///./data/state/support_desk.sqlite3

# Scheduler (Asia/Kolkata)
WEEKLY_CRON=0 9 * * 1
TZ=Asia/Kolkata

# MCP (D1: TypeScript server over stdio)
MCP_BACKEND=local
MCP_SERVER_CMD=node mcp-server/dist/index.js
LOCAL_DOC_PATH=samples/appended_doc_entry.md
LOCAL_EMAIL_PATH=samples/email_draft.md
PRODUCT_TEAM_EMAILS=

# Google OAuth (only when MCP_BACKEND=google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
GOOGLE_TOKEN_PATH=./mcp-server/data/google-token.json
GOOGLE_TOKEN_JSON=
GOOGLE_DOCS_ID=

# Fee explainer schemes (comma-separated; arch §7.7 / D5)
EXPLAINER_SCHEMES=large_cap,gold_fof

# Trend thresholds (arch §7.4)
TREND_RISING_RATIO=1.5
TREND_RISING_MIN_SUM=5
TREND_RECURRING_WEEK_RATIO=0.5
TREND_RECURRING_MIN_COUNT=20
TREND_MIN_WEEK_DAYS=4

# Repeat-question bridge (arch §9.1)
REPEAT_MIN=5
REPEAT_WINDOW_DAYS=7
